{
  "version": "0.7.0",
  "description": "PC Junk Cleaner 内置清理规则（单一数据源）。",
  "note": "路径支持 Windows 环境变量（%TEMP% / %LOCALAPPDATA% / %APPDATA% / %WINDIR% / %USERPROFILE% / %SYSTEMDRIVE%）、~ 与 <CWD> 占位符；分隔符统一使用 /，运行时自动规范化。带 \"deep_only\": true 的规则只在 --deep 深度模式下启用。",
  "categories": [
    {
      "key": "system_temp",
      "label": "系统临时文件",
      "risk": "safe",
      "targets": [
        { "type": "clear_dir", "path": "%TEMP%", "label": "用户临时文件" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/CrashDumps", "label": "崩溃转储缓存" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Windows/Explorer", "pattern": "thumbcache_*.db", "label": "缩略图缓存" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Windows/Explorer", "pattern": "iconcache_*.db", "label": "图标缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/WebCache", "label": "网页窗口缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/WER", "label": "Windows 错误报告" },
        { "type": "clear_dir", "path": "%APPDATA%/Microsoft/Windows/Recent", "label": "最近文档/跳转列表" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/Caches", "label": "Windows 图标/字体缓存", "deep_only": true }
      ]
    },
    {
      "key": "gpu_caches",
      "label": "GPU 着色器缓存",
      "risk": "safe",
      "targets": [
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/NVIDIA/DXCache", "label": "NVIDIA DXCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/NVIDIA/GLCache", "label": "NVIDIA GLCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/AMD/DXCache", "label": "AMD DXCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/AMD/GLCache", "label": "AMD GLCache" }
      ]
    },
    {
      "key": "web_cache",
      "label": "浏览器/网页缓存",
      "risk": "safe",
      "targets": [
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Cache", "action": "clear", "label": "Edge 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Code Cache", "action": "clear", "label": "Edge 代码缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Steam/htmlcache", "label": "Steam 网页缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/INetCache", "label": "INetCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/component_crx_cache", "label": "Edge 组件缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/extensions_crx_cache", "label": "Edge 扩展缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/GrShaderCache", "label": "Edge 着色器缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/ShaderCache", "label": "Edge 常驻着色器缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/GPUPersistentCache", "label": "Edge GPU 持久缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Edge GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnGraphiteCache", "action": "clear", "label": "Edge Dawn 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnWebGPUCache", "action": "clear", "label": "Edge WebGPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Cache", "action": "clear", "label": "Chrome 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Code Cache", "action": "clear", "label": "Chrome 代码缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Chrome GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnGraphiteCache", "action": "clear", "label": "Chrome Dawn 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnWebGPUCache", "action": "clear", "label": "Chrome WebGPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Mozilla/Firefox/Profiles", "pattern": "*/cache2", "action": "clear", "label": "Firefox 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/BraveSoftware/Brave-Browser/User Data", "pattern": "*/Cache", "action": "clear", "label": "Brave 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/BraveSoftware/Brave-Browser/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Brave GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Vivaldi/User Data", "pattern": "*/Cache", "action": "clear", "label": "Vivaldi 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Vivaldi/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Vivaldi GPU 缓存" },
        { "type": "glob_dirs", "base": "%APPDATA%/Opera Software/Opera Stable", "pattern": "Cache", "action": "clear", "label": "Opera 缓存" },
        { "type": "glob_dirs", "base": "%APPDATA%/Opera Software/Opera Stable", "pattern": "GPUCache", "action": "clear", "label": "Opera GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Service Worker/CacheStorage", "action": "clear", "label": "Edge Service Worker 缓存", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Service Worker/CacheStorage", "action": "clear", "label": "Chrome Service Worker 缓存", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnCache", "action": "clear", "label": "Edge DawnCache", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnCache", "action": "clear", "label": "Chrome DawnCache", "deep_only": true }
      ]
    },
    {
      "key": "wechat_cache",
      "label": "微信运行缓存",
      "risk": "safe",
      "targets": [
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/xplugin", "label": "微信 xplugin" },
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/radium", "label": "微信 radium" },
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/log", "label": "微信日志" },
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/crashinfo", "label": "微信崩溃报告" }
      ]
    },
    {
      "key": "game_caches",
      "label": "游戏平台缓存",
      "risk": "moderate",
      "targets": [
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/perfectworldarena-updater/pending", "label": "完美世界更新包缓存" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/perfectworldarena-updater", "pattern": "installer*.exe", "label": "完美世界更新安装包残留" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Steam/appcache", "label": "Steam 应用缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Steam/logs", "label": "Steam 日志" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Steam/htmlcache", "pattern": "*.log", "label": "Steam 网页缓存日志" }
      ]
    },
    {
      "key": "dev_caches",
      "label": "开发工具缓存",
      "risk": "moderate",
      "targets": [
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/pnpm-cache", "label": "pnpm 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/pnpm/store", "label": "pnpm store" },
        { "type": "clear_dir", "path": "D:/.pnpm-store", "label": "D 盘 pnpm store" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/pip/cache", "label": "pip 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/npm-cache", "label": "npm 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/uv/cache", "label": "uv 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Yarn/Cache", "label": "yarn 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/go-build", "label": "Go 构建缓存" },
        { "type": "clear_dir", "path": "~/go/pkg/mod/cache", "label": "Go 模块缓存" },
        { "type": "clear_dir", "path": "~/.cargo/registry", "label": "cargo 依赖缓存" },
        { "type": "clear_dir", "path": "~/.gradle/caches", "label": "Gradle 缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/NuGet/v3-cache", "label": "NuGet 缓存" },
        { "type": "clear_dir", "path": "%TEMP%/WinGet", "label": "WinGet 临时安装包" },
        { "type": "find_dirs", "bases": ["<CWD>"], "names": ["__pycache__", ".pytest_cache", ".mypy_cache", ".ruff_cache"], "action": "delete", "label": "散落工具缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/electron/Cache", "label": "Electron 缓存", "deep_only": true },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/discord/Cache", "label": "Discord 缓存", "deep_only": true },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Telegram Desktop/tupdates", "label": "Telegram 更新缓存", "deep_only": true }
      ]
    },
    {
      "key": "downloads",
      "label": "下载/旧文件",
      "risk": "risky",
      "targets": [
        { "type": "files_by_rule", "base": "~/Downloads", "min_size_mb": 100, "older_than_days": 180, "label": "下载的大/旧文件" },
        { "type": "glob_files", "base": "~/Downloads", "pattern": "*.exe", "min_size_mb": 1, "older_than_days": 30, "label": "下载的安装包(.exe)" },
        { "type": "glob_files", "base": "~/Downloads", "pattern": "*.msi", "min_size_mb": 1, "older_than_days": 30, "label": "下载的安装包(.msi)" }
      ]
    },
    {
      "key": "system_admin",
      "label": "系统深度清理(需管理员)",
      "risk": "moderate",
      "require_admin": true,
      "targets": [
        { "type": "clear_dir", "path": "%WINDIR%/SoftwareDistribution/Download", "label": "Windows 更新缓存" },
        { "type": "clear_dir", "path": "%WINDIR%/Prefetch", "label": "预读取(Prefetch)" },
        { "type": "clear_dir", "path": "%WINDIR%/Temp", "label": "系统临时文件(Windows\\Temp)" },
        { "type": "glob_dirs", "base": "%SYSTEMDRIVE%/", "pattern": "found.*", "action": "delete", "label": "chkdsk 残留(found.*)" },
        { "type": "glob_files", "base": "%WINDIR%", "pattern": "KB*.log", "label": "Windows 更新日志(KB*.log)" },
        { "type": "glob_files", "base": "%WINDIR%", "pattern": "*.bak", "label": "Windows 备份残留(*.bak)" },
        { "type": "clear_dir", "path": "%WINDIR%/Logs/WindowsUpdate", "label": "Windows 更新诊断日志" },
        { "type": "glob_files", "base": "%WINDIR%/System32/winevt/Logs", "pattern": "Archive-*.evtx", "label": "事件日志归档" },
        { "type": "glob_files", "base": "%WINDIR%/Minidump", "pattern": "*.dmp", "label": "系统崩溃转储" },
        { "type": "glob_files", "base": "%WINDIR%/LiveKernelReports", "pattern": "**/*.dmp", "label": "Live 内核报告" }
      ]
    },
    {
      "key": "windows_old",
      "label": "旧版 Windows 残留",
      "risk": "risky",
      "require_admin": true,
      "targets": [
        { "type": "delete_dir", "path": "%SYSTEMDRIVE%/Windows.old", "label": "Windows.old 残留" }
      ]
    },
    {
      "key": "dev_purge",
      "label": "项目构建产物(高风险)",
      "risk": "risky",
      "targets": [
        { "type": "find_dirs", "bases": ["<CWD>"], "names": ["node_modules", "dist", "build", "target", ".next", ".nuxt", ".output", "coverage"], "action": "delete", "label": "散落构建产物" }
      ]
    },
    {
      "key": "browser_privacy",
      "label": "浏览器隐私数据(高风险)",
      "risk": "risky",
      "targets": [
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Cookies", "label": "Edge Cookie" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/History", "label": "Edge 浏览历史" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Cookies", "label": "Chrome Cookie" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/History", "label": "Chrome 浏览历史" },
        { "type": "glob_files", "base": "%APPDATA%/Mozilla/Firefox/Profiles", "pattern": "*/cookies.sqlite", "label": "Firefox Cookie" },
        { "type": "glob_files", "base": "%APPDATA%/Mozilla/Firefox/Profiles", "pattern": "*/places.sqlite", "label": "Firefox 浏览历史" }
      ]
    }
  ]
}
