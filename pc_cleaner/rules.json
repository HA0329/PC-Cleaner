        { "type": "compact_db", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/History", "label": "Chrome 历史库压缩" },
        { "type": "compact_db", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Web Data", "label": "Chrome 表单库压缩" },
