        { "type": "glob_files", "base": "%LOCALAPPDATA%/Steam/htmlcache", "pattern": "*.log", "label": "Steam 网页缓存日志" },
        { "type": "find_dirs", "bases": ["%PROGRAMFILES(X86)%/Steam/steamapps", "%PROGRAMFILES%/Steam/steamapps", "D:/Steam/steamapps", "E:/Steam/steamapps", "D:/Program Files (x86)/Steam/steamapps", "E:/Program Files/Steam/steamapps"], "names": ["shadercache"], "action": "clear", "label": "Steam 着色器缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/EpicGamesLauncher/Saved/webcache", "label": "Epic 启动器网页缓存" },
