        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Code Cache", "action": "clear", "label": "Edge 代码缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Steam/htmlcache", "label": "Steam 网页缓存" },
