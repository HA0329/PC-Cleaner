    {
      "key": "downloads",
      "label": "下载/旧文件",
      "risk": "risky",
      "targets": [
        { "type": "files_by_rule", "base": "~/Downloads", "min_size_mb": 100, "older_than_days": 180, "label": "下载的大/旧文件" },
