        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/GrShaderCache", "label": "Edge 着色器缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/ShaderCache", "label": "Edge 常驻着色器缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Edge/User Data/GPUPersistentCache", "label": "Edge GPU 持久缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Edge GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnGraphiteCache", "action": "clear", "label": "Edge Dawn 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnWebGPUCache", "action": "clear", "label": "Edge WebGPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Cache", "action": "clear", "label": "Chrome 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Code Cache", "action": "clear", "label": "Chrome 代码缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Chrome GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnGraphiteCache", "action": "clear", "label": "Chrome Dawn 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnWebGPUCache", "action": "clear", "label": "Chrome WebGPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Mozilla/Firefox/Profiles", "pattern": "*/cache2", "action": "clear", "label": "Firefox 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/BraveSoftware/Brave-Browser/User Data", "pattern": "*/Cache", "action": "clear", "label": "Brave 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/BraveSoftware/Brave-Browser/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Brave GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Vivaldi/User Data", "pattern": "*/Cache", "action": "clear", "label": "Vivaldi 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Vivaldi/User Data", "pattern": "*/GPUCache", "action": "clear", "label": "Vivaldi GPU 缓存" },
        { "type": "glob_dirs", "base": "%APPDATA%/Opera Software/Opera Stable", "pattern": "Cache", "action": "clear", "label": "Opera 缓存" },
        { "type": "glob_dirs", "base": "%APPDATA%/Opera Software/Opera Stable", "pattern": "GPUCache", "action": "clear", "label": "Opera GPU 缓存" },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/Service Worker/CacheStorage", "action": "clear", "label": "Edge Service Worker 缓存", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/Service Worker/CacheStorage", "action": "clear", "label": "Chrome Service Worker 缓存", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Microsoft/Edge/User Data", "pattern": "*/DawnCache", "action": "clear", "label": "Edge DawnCache", "deep_only": true },
        { "type": "glob_dirs", "base": "%LOCALAPPDATA%/Google/Chrome/User Data", "pattern": "*/DawnCache", "action": "clear", "label": "Chrome DawnCache", "deep_only": true }
      ]
    },
    {
      "key": "wechat_cache",
      "label": "微信运行缓存",
      "risk": "safe",
      "note": "本机为微信 4.x（Weixin）：聊天记录等数据在数据目录（如 D:/WeixinShuju，含 xwechat_files），本工具绝不触碰；此处仅清理 %APPDATA%/Tencent/xwechat 下可重建的网络缓存。同时清理旧版 3.x 遗留的文件缓存（若存在）。请在微信「设置 → 存储空间」内清理聊天数据。",
      "targets": [
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/net", "label": "微信 4.x 网络缓存" },
        { "type": "clear_dir", "path": "%APPDATA%/Tencent/xwechat/net_1", "label": "微信 4.x 网络缓存(2)" },
        { "type": "glob_dirs", "base": "%USERPROFILE%/Documents/WeChat Files", "pattern": "*/Cache", "action": "clear", "label": "微信 3.x 旧版文件缓存（若存在）", "deep_only": true }
      ]
    },
    {
      "key": "office_caches",
      "label": "办公软件缓存",
      "risk": "safe",
      "note": "Microsoft Office 和 WPS 的本地同步缓存、临时文件，删除后软件会自动重建，不影响文档内容。",
      "targets": [
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Office/16.0/OfficeFileCache", "label": "Office 文档同步缓存（OneDrive/SharePoint）", "deep_only": true },
        { "type": "clear_dir", "path": "%APPDATA%/Kingsoft/wps/cache", "label": "WPS 缓存", "deep_only": true }
      ]
