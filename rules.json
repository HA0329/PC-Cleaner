      "label": "多媒体设计软件缓存",
      "risk": "safe",
      "note": "Adobe Premiere Pro / After Effects 等软件的媒体缓存（峰值、预览），可安全删除并自动重建。",
      "targets": [
        { "type": "clear_dir", "path": "%APPDATA%/Adobe/Common/Media Cache", "label": "Adobe 媒体缓存", "deep_only": true },
        { "type": "clear_dir", "path": "%APPDATA%/Adobe/Common/Media Cache Files", "label": "Adobe 媒体缓存文件", "deep_only": true }
