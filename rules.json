{
  "version": "0.9.0",
  "description": "PC Junk Cleaner 内置清理规则（基于本机实测 + BleachBit/Dism++ 吸收扩充）。v0.9.0 新增：BleachBit 浏览器站点数据（DOM/本地存储、会话、站点偏好、登录/表单数据、搜索引擎、同步数据）、浏览器数据库压缩（compact_db，VACUUM 释放碎片不删数据）、Dism++ 空间回收补充（Windows 事件日志、崩溃内存转储 MEMORY.DMP、.NET 原生映像缓存）。",
  "note": "路径支持 Windows 环境变量（%TEMP% / %LOCALAPPDATA% / %APPDATA% / %WINDIR% / %USERPROFILE% / %SYSTEMDRIVE%）、~ 与 <CWD> 占位符；分隔符统一使用 /，运行时自动规范化。带 \"deep_only\": true 的规则只在 --deep 深度模式下启用；require_admin: true 表示需管理员权限。",
  "manual_notes": "以下为 BleachBit/Dism++ 中的项目，但属于【注册表 / 系统级工具】范畴，本工具不删除、不做伪造路径，仅在此说明（用系统自带工具或注册表处理）：1) MUICache——注册表 HKCU\\Software\\Microsoft\\Windows\\Shell\\MUICache（以及 HKCU\\Software\\Classes\\Local Settings\\Software\\Microsoft\\Windows\\Shell\\MuiCache）；2) 快速运行/最近查询/Shellbags——注册表 RunMRU / TypedPaths / BagMRU；3) 剪贴板——系统剪贴板内容（非文件）；4) 释放磁盘空闲区域——需要覆盖写空白扇区（如 sdelete / cipher /w）；5) 系统还原点——卷影副本（vssadmin delete shadows）；6) 被取代的WinSxS组件——DISM /online /cleanup-image /startcomponentcleanup；7) 以前的Dism++组件——Dism++ 自身残留，通常随其卸载清理；8) 零售演示离线内容 / 损坏的Appx——需按版本判定，建议用 DISM 或系统清理。",
  "categories": [
    {
      "key": "system_temp",
      "label": "系统临时文件",
      "risk": "safe",
      "targets": [
        { "type": "clear_dir", "path": "%TEMP%", "label": "用户临时文件" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/CrashDumps", "label": "崩溃转储缓存" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Windows/Explorer", "pattern": "thumbcache_*.db", "label": "缩略图缓存" },
        { "type": "glob_files", "base": "%LOCALAPPDATA%/Microsoft/Windows/Explorer", "pattern": "iconcache_*.db", "label": "图标缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/WebCache", "label": "网页窗口缓存" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/WER", "label": "Windows 错误报告" },
        { "type": "clear_dir", "path": "%APPDATA%/Microsoft/Windows/Recent", "label": "最近文档/跳转列表" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/Microsoft/Windows/Caches", "label": "Windows 图标/字体缓存", "deep_only": true }
      ]
    },
    {
      "key": "gpu_caches",
      "label": "GPU 着色器缓存",
      "risk": "safe",
      "targets": [
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/NVIDIA/DXCache", "label": "NVIDIA DXCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/NVIDIA/GLCache", "label": "NVIDIA GLCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/AMD/DXCache", "label": "AMD DXCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/AMD/GLCache", "label": "AMD GLCache" },
        { "type": "clear_dir", "path": "%LOCALAPPDATA%/D3DSCache", "label": "DirectX 着色器缓存(D3DSCache)" },
        { "type": "clear_dir", "path": "%PROGRAMDATA%/NVIDIA Corporation/NV_Cache", "label": "NVIDIA NV_Cache 缓存" }
      ]
    },
    {
      "key": "web_cache",
      "label": "浏览器/网页缓存",
      "risk": "safe",
      "targets": [
